{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && swift format --in-place --recursive .",
            "timeout": 30,
            "statusMessage": "Formatting Swift files"
          }
        ]
      }
    ]
  }
}
